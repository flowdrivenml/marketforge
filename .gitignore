# Sanitized HTTP fixtures are source-controlled, unlike generated JSON artifacts.
!forge/tests/unit/historical/archives/fixtures/bitget_*.json

# Ignore local configuration, with exceptions for maintained definitions and examples.
!/data/
/data/*
!/data/.config/
/data/.config/**

# Maintained workload and persistent normalization test outputs.
!engine/tests/historical/fixtures/normalize.json
!engine/tests/historical/fixtures/merge.json
/data/tests/historical/normalize/

# Persistent historical benchmark metadata and generated datasets.
/data/benchmarks/

# Documentation-only environment and generated site
/docs/.venv/
/docs/site/
/docs/.cache/

# Forge-managed engine installation and persistent operation locks
/.bin/marketforge-normalize
/.bin/marketforge-merge
/.bin/manifest.json
/.marketforge-engine.lock
/.marketforge-profiles.lock

# Small documented input examples.
!docs/content/examples/catalogue/synthetic-depth.jsonl
!docs/content/examples/catalogue/synthetic-trades.csv

# Source-controlled configuration definitions and workflow example.
!/data/.config/engine/
!/data/.config/engine/normalize/
!/data/.config/engine/normalize/profiles/
