    },
};

static NEXT_TEST_ID: AtomicU64 = AtomicU64::new(0);

fn sample_trade(index: i64) -> Trade {
    Trade {
        envelope: EventEnvelope {
            event_timestamp_ns: 1_788_220_800_000_000_000 + index,
            system_timestamp_ns: None,
            exchange: Exchange::Bybit,
